    - id: 6
      fields:
      - title: Title
        value: Manual Law Library
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "<div class=\"section-header\">SECTION 9 \uFFFD LEGAL INFORMATION</div>\n\n<div
          class=\"institutional\">\nLAW LIBRARY \uFFFD 9.01\n\nThe Law Library provides
          assistance to prisoners in \nresearch and preparation of legal work. The
          Law \nLibrarian assists prisoners in requesting materials \uFFFD \nthey
          do not do the legal work for you.\n\nTo access the Law Library, sign up
          on the Law Library \nlist in your living area. Staff collect the list \nnightly.
          You must request access daily \uFFFD no one will \nbe automatically called.\n\nPrisoners
          may use the Law Library one hour per day.\n\nA prisoner has the right to
          receive assistance from \nanother prisoner in the use of the Law Library.
          A \nprisoner providing such assistance may not charge or \nreceive payment
          of any kind.\n\nLEGAL COPIES \uFFFD 9.02\n\nLegal copies cost 15 cents
          per page. Complete a \ndisbursement form with your name, offender number,
          \ndate, and number of copies. Copies will be returned \nwithin three working
          days.\n\nAn indigent prisoner may have copies made, as required \nby the
          court, at state expense.\n</div>\n\n<div class=\"player-thought\">\nYou'd
          have to sign up on a list today to get in \ntomorrow. You don't know where
          the list is yet.\nOne hour. That's what you get.\nYou file this away. You
          might need it.\n</div>\n\n---"
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 15
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 15
        originDialogueID: 6
        destinationConversationID: 15
        destinationDialogueID: 19
        isConnector: 0
        priority: 2
      - originConversationID: 15
        originDialogueID: 6
        destinationConversationID: 15
        destinationDialogueID: 20
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
