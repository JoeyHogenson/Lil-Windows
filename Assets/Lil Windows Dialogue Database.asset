    - id: 8
      fields:
      - title: Title
        value: Manual Phone
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "<div class=\"section-header\">SECTION 6 \uFFFD TELEPHONES</div>\n\n<div
          class=\"institutional\">\nTELEPHONES \uFFFD 6.01\n\nTelephone service at
          this facility is operated by \nSecurus, Inc., a private contractor. It
          is not \naffiliated with any local or long distance providers \nin Alaska.\n\nThe
          telephones are in service between 8:00 a.m. \nand 10:00 p.m. daily.\n\nCalls
          are limited to 15 minutes.\n\nAll long distance calls must be collect.
          Phone cards \nand 800 numbers will not work. Prisoners cannot \nreceive
          incoming calls.\n\nThe person you are calling must open an account with
          \nSecurus in order to accept your call. They may do so \nby calling 1-800-844-6591.
          In some cases a deposit \nwill be required.\n\nAll prisoners are required
          to enter their pre-assigned \nPIN number when placing a call. Do not exchange
          or \nallow other prisoners to use your PIN.\n\nFor security reasons, the
          phones may be disabled at \nany time with little or no notice.\n</div>\n\n<div
          class=\"player-thought\">\nFifteen minutes.\nThe person you want to call
          needs an account first.\nYou try to remember if they would know to set
          one up.\nYou don't know if they know you're here yet.\nYour PIN is on a
          slip of paper somewhere in your \nintake paperwork. You need to find that.\n</div>\n\n---"
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 15
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 15
        originDialogueID: 8
        destinationConversationID: 15
