    - id: 7
      fields:
      - title: Title
        value: Manual Mail
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "<div class=\"section-header\">SECTION 3 \uFFFD MAIL</div>\n\n<div
          class=\"institutional\">\nGENERAL MAIL \uFFFD 3.01\n\nPrisoners are responsible
          for their own postage costs.\n\nYou may not receive postage stamps in the
          mail. \nStamps must be purchased through commissary.\n\nOutgoing mail must
          be addressed as follows:\n\n[Your name as booked]\nFairbanks Correctional
          Center\n1931 Eagan Ave.\nFairbanks, AK 99701\n\nMail with any other return
          address will be sent back \nto you and will not be mailed out of the institution.\n\nThe
          institution will, at its expense, provide postage \nfor up to five pieces
          of mail per week for any \nprisoner determined to be indigent.\n\nDO NOT
          SEAL OUTGOING MAIL.\n</div>\n\n<div class=\"player-thought\">\nYou'd need
          a stamp to send anything.\nStamps come from commissary.\nCommissary requires
          money.\nOr you qualify as indigent and submit a form.\nWhich requires a
          cop-out.\nWhich requires a form.\n\nYou close that loop in your head and
          leave it there.\n</div>\n\n---"
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 15
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 15
        originDialogueID: 7
        destinationConversationID: 15
        destinationDialogueID: 21
        isConnector: 0
        priority: 2
      - originConversationID: 15
        originDialogueID: 7
        destinationConversationID: 15
        destinationDialogueID: 22
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
      onExecute:
        m_PersistentCalls:
          m_Calls: []
      canvasRect:
        serializedVersion: 2
        x: 1848
