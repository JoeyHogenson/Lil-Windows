        width: 160
        height: 30
    - id: 1
      fields:
      - title: Title
        value: Arrest
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: 'You step out. You are told to put your hands behind your back.

          The
          handcuffs are applied. They are not rough about it.

          You are
          guided to the back of the patrol car.


          The door closes.


          Through
          the window you can see your car. The driver''s side

          door is
          still open. Your phone is on the passenger seat.


          Your shift
          starts in sixty-six minutes. You have a paper

          due Thursday.
          The tutoring center is probably open today.'
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 14
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 14
        originDialogueID: 1
        destinationConversationID: 14
        destinationDialogueID: 12
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
      onExecute:
        m_PersistentCalls:
          m_Calls: []
      canvasRect:
        serializedVersion: 2
        x: 80
        y: 974
        width: 160
        height: 30
    - id: 2
      fields:
      - title: Title
        value: Bail Screen
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "The judge's bench warrant set bail at [var=250]. \n\nYou have 340
          in your checking account.\n\nYou have 0 in savings.\n\nRent is due Friday.\n\nYou
          can make one call."
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 14
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks: []
      conditionsString: 
      userScript: 
      onExecute:
        m_PersistentCalls:
          m_Calls: []
      canvasRect:
        serializedVersion: 2
        x: 80
        y: 1310
        width: 160
        height: 30
    - id: 3
      fields:
      - title: Title
        value: Booking
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: 'The processing facility is fluorescent and beige. A clerk

          sits
          behind a window. Your belongings are catalogued and

          placed into
          a bag: wallet, keys, phone. Each item is named

          aloud and recorded.


          Your
          dining hall shift will start without you. You do not

          know yet
          who will cover it or what they will be told.


          You are given
          a number.'
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 14
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 14
        originDialogueID: 3
        destinationConversationID: 14
        destinationDialogueID: 13
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
      onExecute:
        m_PersistentCalls:
          m_Calls: []
      canvasRect:
        serializedVersion: 2
        x: 80
        y: 1142
        width: 160
        height: 30
    - id: 7
      fields:
      - title: Title
        value: Morning Drive
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: 'The route to campus takes about eighteen minutes depending

          on
          the light at Geist. You have a playlist. You don''t turn

          it
          on. You think about the paper. You think about your

          shift. You
          think about whether the tutoring center is open

          on Mondays and
          whether you''d have to make an appointment

          or if you could just
          walk in.


          The light at Geist turns yellow. You go through it.

          It''s
          close, but you go through it.


          In your mirror, a patrol car
          pulls out from the side street.


          The lights come on.'
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 14
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 14
        originDialogueID: 7
        destinationConversationID: 14
        destinationDialogueID: 14
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
      onExecute:
        m_PersistentCalls:
          m_Calls: []
      canvasRect:
        serializedVersion: 2
        x: 80
        y: 470
        width: 160
        height: 30
    - id: 8
      fields:
      - title: Title
        value: Morning Work
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: 'You check the bus schedule on your phone. The 8:40 gets you

          to
          campus by 9:15, which gives you enough time to stop by

          the student
          services building. There''s a bowl of granola bars

          on the desk
          near the tutoring sign-up. You''ve taken one before.

          You''re
          not sure if you''re supposed to.


          You decide to drive. It''s
          faster and you''re already tired.

          Gas is low but enough.


          You
          think about the paper on the way out the door.

          You lock the
          deadbolt twice the way you always do.'
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 14
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 14
        originDialogueID: 8
        destinationConversationID: 14
        destinationDialogueID: 15
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
      onExecute:
        m_PersistentCalls:
          m_Calls: []
      canvasRect:
        serializedVersion: 2
        x: 80
        y: 302
        width: 160
        height: 30
    - id: 9
      fields:
      - title: Title
        value: Start
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: 'Monday. Your alarm goes off at 6:12. You set it for 6:10

          but
          you always hit snooze once. You have [var=340] in your

          checking
          account. You know this without looking. Rent is

          due on the first,
          which is Friday. You''ve already done the

          math: [var=340] minus
          [var=310] leaves thirty dollars for the week.


          You think about
          what''s in the kitchen. Two packets of ramen.

          A box of NutriGrain
          bars with four left. Some rice.

          It''s tight but it''s not impossible.
          You''ve done tighter.


          You make coffee. You have a shift at
          the campus dining hall

          at 10. You also have a paper due Thursday
          that you haven''t

          started. You think about both of these at
          the same time.'
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 14
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 14
        originDialogueID: 9
        destinationConversationID: 14
        destinationDialogueID: 16
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
      onExecute:
        m_PersistentCalls:
          m_Calls: []
      canvasRect:
        serializedVersion: 2
        x: 80
        y: 134
        width: 160
        height: 30
    - id: 10
      fields:
      - title: Title
        value: Traffic Stop
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: 'You pull over. You turn off the engine. You put both hands

          on
          the wheel.


          The officer approaches the driver''s side window.
          You lower it.


          "License and registration."


          You have
          your license in your wallet. The registration is

          in the glove
          box. You''ve looked for it twice before.

          It''s there. You find
          it on the first try this time.


          You hand them over. The officer
          walks back to the patrol car.


          You check the time on your phone.
          8:54.'
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 14
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 14
        originDialogueID: 10
        destinationConversationID: 14
        destinationDialogueID: 17
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
      onExecute:
        m_PersistentCalls:
          m_Calls: []
      canvasRect:
        serializedVersion: 2
        x: 80
        y: 638
        width: 160
        height: 30
    - id: 11
      fields:
      - title: Title
        value: Warrant Return
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: 'The officer comes back. There is a second officer with them

          now.
          You didn''t see the second car arrive.


          "There''s a bench warrant
          showing on this plate. Failure to appear, Fairbanks District Court."


          You
          start to explain. There was a ticket. You thought you''d

          paid
          it. You weren''t sure where the court date was.


          The officer
          is already writing. They are not unkind about it.


          "Step out
          of the vehicle, please."'
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 14
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 14
        originDialogueID: 11
        destinationConversationID: 14
        destinationDialogueID: 18
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
      onExecute:
        m_PersistentCalls:
          m_Calls: []
      canvasRect:
        serializedVersion: 2
        x: 80
        y: 806
        width: 160
        height: 30
