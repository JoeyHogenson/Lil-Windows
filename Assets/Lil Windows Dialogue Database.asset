    - id: 5
      fields:
      - title: Title
        value: Manual Count
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "<div class=\"section-header\">SECTION 13 \uFFFD COUNT AND DAILY SCHEDULE</div>\n
          \n<div class=\"institutional\">\nCOUNT TIMES \uFFFD 13.01\n\nCount is conducted
          multiple times daily at the times \nposted in your living area.\n\nDuring
          count, all prisoners in their living area will \nbe by their bunk. This
          means a prisoner may not remain \nin a day room, may not remain on the
          phone, may not \ncontinue a card game, may not stay in the shower.\n\nDuring
          prisoner counts a prisoner will not talk to \nother prisoners or staff
          while officers are in their \narea counting. During prisoner counts a prisoner
          will \nnot move within their living area while count officers \nare present.\n\nAny
          prisoner not in their living area during count will \nremain in the area
          they are in until count is cleared.\n</div>\n\n<div class=\"player-thought\">\nCount
          times are posted on the wall near the door. \nYou make a note to look at
          them before anything else.\nIf count clears and you're somewhere you're
          not \nsupposed to be, that's already a problem.\n</div>\n\n---"
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 15
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 15
        originDialogueID: 5
        destinationConversationID: 15
        destinationDialogueID: 17
        isConnector: 0
        priority: 2
      - originConversationID: 15
        originDialogueID: 5
        destinationConversationID: 15
        destinationDialogueID: 18
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
      onExecute:
