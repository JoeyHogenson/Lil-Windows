    - id: 35
      fields:
      - title: Title
        value: 
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "He taps the paper.\n\n\u201CQuiero mostrarte algo.\u201D\n\nYou watch
          his mouth.\n\n\u201CLlevas aqu\xED tres d\xEDas.\u201D\n\nTres d\xEDas.\n\nYou
          catch silencio. His mouth keeps moving.\n\n\u201CEst\xE1 bien.\u201D He
          pauses and looks right at you.\n\n\"Pero noto\u2026\u201D\n\nYour eyes
          stay on his face and your stomach tightens.\n\nHe knows.\n\nThere is a
          silence.\n\nThen he looks directly at you and you watch as his mouth forms
          two words.\n\n\xBFEres sordo?"
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 20
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 20
        originDialogueID: 35
        destinationConversationID: 20
        destinationDialogueID: 14
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
      onExecute:
        m_PersistentCalls:
          m_Calls: []
      canvasRect:
        serializedVersion: 2
        x: 1700.2345
        y: 422.8539
        width: 160
        height: 30
    - id: 36
      fields:
      - title: Title
        value: 
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "He holds up the paper.\n\n\u201CEsto es un poema. Espa\xF1ol.\u201D\n\nYour
          eyes drop to the page.\n\nEspa\xF1ol.\n\nYou don't need to read his lips
          anymore.\n\n\u201CInvicto.\u201D\n\nYou look at the word.\n\nYou know it.\n\n\"Invicto.\"\n\n\nChico
          keeps talking, explaining it in English, but you are already somewhere
          inside the word.\n\n\nYou look up at him.\n\nHis mouth is still moving.\n\nThen
          he asks:\n\n\u201C\xBFEntiendes espa\xF1ol?\u201D\n\nYou almost laugh.\n\nAnd
          for the first time since you arrived, you wonder if Chico understands that
          the Spanish on the page is not something you need translated.\n\nIt is
          the part you understand."
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 20
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 20
        originDialogueID: 36
        destinationConversationID: 20
        destinationDialogueID: 15
        isConnector: 0
        priority: 2
      - originConversationID: 20
        originDialogueID: 36
        destinationConversationID: 20
        destinationDialogueID: 16
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
      onExecute:
        m_PersistentCalls:
          m_Calls: []
