        height: 30
    - id: 10
      fields:
      - title: Title
        value: "You fold the paper carefully and tuck it somewhere safe\u2014under
          your mattress, in your diary, somewhere close."
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "You fold the paper carefully and tuck it somewhere safe\u2014under
          your mattress, in your diary, somewhere close.\n\nChico nods, satisfied.\n\nHe
          gets back up on the bunk.\n\nThe morning is quiet. The poem is with you
          now."
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 20
      isRoot: 0
      isGroup: 0
      nodeColor: 
