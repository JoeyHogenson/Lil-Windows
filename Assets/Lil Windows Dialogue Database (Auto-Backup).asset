    - id: 5
      fields:
      - title: Title
        value: You shrug.
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "You shrug.\n\n\"Entendido\", says Chico. \"Sigues las palabras.\"\n\nHe
          hands you a pen. \n\n\"Si no entiendes, escr\xEDbelo. No problema.\"\n\nHe
          sits down, holding the paper so you can see.\n\nYou settle in."
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 20
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
