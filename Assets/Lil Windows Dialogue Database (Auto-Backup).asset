    - id: 8
      fields:
      - title: Title
        value: 'You sit down and pull out your diary. '
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "You sit down and pull out your diary. \n\nChico sits beside you or
          watches from the bunk.\n\nYou begin copying the lines in Spanish, slowly,
          carefully. Chico helps when you hesitate on a word.\n\nThe morning passes
          quietly. By the time you finish, the poem is yours\u2014written in your
          own hand, in Spanish, in your diary.\n\nWhen you're done, Chico nods."
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 20
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 20
        originDialogueID: 8
        destinationConversationID: 20
        destinationDialogueID: 28
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
      onExecute:
        m_PersistentCalls:
          m_Calls: []
      canvasRect:
        serializedVersion: 2
        x: 1387.4774
        y: 1226.8695
        width: 160
        height: 30
    - id: 9
      fields:
      - title: Title
        value: '"Vale," dice Chico. '
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "\"Vale,\" dice Chico. \n\nSe acomoda, sosteniendo el papel.\n\nRepasa
          m\xE1s estrofas contigo, verso por verso. Te explica el significado detr\xE1s
          de las palabras. Habla de c\xF3mo este poema fue escrito por alguien que
          sab\xEDa lo que se sent\xEDa al estar atrapado, al no tener poder a los
          ojos del mundo\u2014pero ser inquebrantable por dentro.\n\n\"Esa somos
          nosotros\", dice. \"Eso es lo que no entienden. Pueden cerrar las puertas
          con llave, pero no pueden encerrarnos.\"\n\nSe sientan juntos durante mucho
          tiempo, leyendo y hablando. Al final, las palabras sienten como si les
          pertenecieran."
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 20
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 20
        originDialogueID: 9
        destinationConversationID: 20
        destinationDialogueID: 29
        isConnector: 0
        priority: 2
      - originConversationID: 20
        originDialogueID: 9
        destinationConversationID: 20
