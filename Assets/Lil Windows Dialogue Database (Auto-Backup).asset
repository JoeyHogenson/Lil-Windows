        typeString: 
      - title: Dialogue Text
        value: "Mail Call Confusion --- It\u2019s mail call. You can\u2019t tell
          if staff are hollering for you, and you have no envelopes."
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
