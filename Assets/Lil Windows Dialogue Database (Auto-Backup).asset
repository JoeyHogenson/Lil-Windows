        height: 30
    - id: 7
      fields:
      - title: Title
        value: Invicto
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "\u201CInvicto.\u201D\n\nMiras la palabra.\n\nLa conoces.\n\n\u201CEste
          poema\u2014trata sobre sobrevivir. Sobre mantenerte entero cuando el sistema
          intenta quebrarte.\u201D\n\nMiras su boca.\n\n\"Sobrevivir.\"\n\"Sistema.\"\n\"Romper.\"\n\nEntiendes
          lo suficiente.\n\n\u201CEres nuevo aqu\xED. Vas a descubrirlo: hacen reglas.
          Cierran puertas. Deciden cu\xE1ndo comes, duermes, trabajas, todo.\u201D\n\nMueve
          las manos mientras habla. No est\xE1 haciendo se\xF1as. Solo gesticula.\n\nSe\xF1ala
          alrededor de la habitaci\xF3n.\n\nEsa parte ya la entiendes.\n\nLuego se\xF1ala
          tu pecho.\n\n\u201C\xBFPero aqu\xED dentro?\u201D\n\nSu dedo descansa contra
          su propio pecho.\n\n\u201CEso es tuyo. Eso es lo que controlas.\u201D\n\nMiras
          su rostro.\n\nLee los primeros versos de la p\xE1gina, lentamente.\n\n\u201CDe
          la noche que me cubre, negra como un pozo\u2026\u201D\n\nTus ojos siguen
          las palabras.\n\nNo necesitas mirar su boca.\n\nLuego traduce.\n\n\u201CDe
          la noche que me cubre, oscura como un pozo\u2026\u201D\n\nHace una pausa,
          buscando en la p\xE1gina, y encuentra la estrofa que quiere.\n\n\u201CSoy
          due\xF1o de mi destino,\nSoy capit\xE1n de mi alma.\u201D\n\nLevanta la
          mirada.\n\n\u201CSoy due\xF1o de mi destino. Soy capit\xE1n de mi alma.
          De eso trata todo, hermano.\u201D\n\nLees junto con \xE9l.\n\nPero una
          palabra te llama la atenci\xF3n.\n\nDue\xF1o.\n\nConoces la palabra.\n\nDue\xF1o
          de una casa.\nEl due\xF1o de un negocio.\n\nPropietario.\n\nPero \xBFaqu\xED?\n\nLa
          se\xF1alas.\n\nChico te observa.\n\n\u201C\xBFDue\xF1o?\u201D\n\nAsientes.\n\nQuieres
          saber qu\xE9 quiere decir con ella. No solo la traducci\xF3n. La palabra.\n\nHaces
          m\xEDmica de abrir un libro y luego buscar algo.\n\nDiccionario.\n\nChico
          entiende.\n\nSu expresi\xF3n cambia.\n\n\u201C\xBFDiccionario?\u201D\n\nVuelves
          a asentir.\n\nPiensa por un momento.\n\n\u201CNo creo que tengan uno aqu\xED.\u201D\n\nEsperas.\n\nChico
          se encoge de hombros.\n\n\u201CPodr\xEDa preguntar.\u201D\n\nMiras el poema
          otra vez.\n\nSoy due\xF1o de mi destino.\n\nChico te mira.\n\nVuelves a
          mirar la palabra.\n\nDue\xF1o.\n\nPropietario.\n\nAmo.\n\nEl que posee.\n\nEl
          que tiene autoridad."
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
