    - id: 6
      fields:
      - title: Title
        value: Chico shrugs, not bothered.
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: 'Chico shrugs, not bothered.


          "No problem. I''ll read slow.
          You follow with your eyes. If you don''t understand, we figure it out."


          He
          sits down on the floor, the paper ready.


          You settle in.'
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 20
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 20
        originDialogueID: 6
        destinationConversationID: 20
        destinationDialogueID: 22
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
      onExecute:
        m_PersistentCalls:
