    - id: 1
      fields:
      - title: Title
        value: '"I don''t want to mess this up."'
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 6
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 6
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: Look, inmate, my kid's got a school thing tonight. I already missed
          the last one. What do you actually need right now?
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 24
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 24
        originDialogueID: 1
        destinationConversationID: 24
        destinationDialogueID: 10
        isConnector: 0
