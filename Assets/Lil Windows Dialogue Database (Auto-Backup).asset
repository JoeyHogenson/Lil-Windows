        serializedVersion: 2
        x: 80.66667
        y: 302
        width: 160
        height: 30
    - id: 3
      fields:
      - title: Title
        value: Give up, sit alone, feeling isolated.
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "SHADOW Only: An ache of loneliness sets in.\n\nLIL WINDOW: Later,
          a passing counselor notices and leaves you a pamphlet on \u201Cresources
          for new arrivals.\u201D Inside: instructions for requesting family phone
          calls."
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
