    - id: 11
      fields:
      - title: Title
        value: 'TIME MESSAGE: 2pm Count'
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "TIME MESSAGE: 2pm count. \n\nDoors lock throughout the tier. \n\nYou're
          locked in your cell with Chico.\n\nSilence. Waiting. The count takes about
          20 minutes. Then doors unlock again.\n\n[[Back to Cell]"
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 20
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks: []
      conditionsString: 
      userScript: 
      onExecute:
        m_PersistentCalls:
          m_Calls: []
      canvasRect:
        serializedVersion: 2
        x: 763.4774
        y: 1394.8698
        width: 160
        height: 30
    - id: 12
      fields:
      - title: Title
        value: You SIGN BOOK
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "You sign BOOK.\n\nChico nods. \n\nYou sign again. ASL.\n\nHe watches
          your hands.\n\n\u201CASL?\u201D\n\nYou nod.\n\nHe looks toward the shelves.\n\n\u201C\xBFQuieres
          un libro de ASL?\u201D\n\nYou shake your head.\n\nYou sign BOOK again,
          then ASL.\n\nChico studies you.\n\n\u201C\xBFUn libro para ASL?\u201D\n\nYou
          nod.\n\nHe thinks about that."
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 20
      isRoot: 0
      isGroup: 0
      nodeColor: 
