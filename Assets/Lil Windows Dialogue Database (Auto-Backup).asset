      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: 'You set the handbook on the bunk.


          The cover faces up.
          FAIRBANKS CORRECTIONAL CENTER.

          Your offender number in red ink
          on the inside cover.


          It will be here when you need it.'
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
