    - id: 14
      fields:
      - title: Title
        value: Name is Les Miserables Cat
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "\u201CLes Mis\xE9rables Cat,\u201D you announce quietly.\n\nThe bug
          continues walking the perimeter of the cell like it\u2019s inspecting property
          lines.\n\n\u201CThat\u2019s not a cat,\u201D the vent says.\n\n\u201CIt
          survives,\u201D you reply.\n\nThe bug stops near a crumb you missed at
          dinner.\n\n\u201CYou think it\u2019s Jean Valjean or Javert?\u201D the
          voice asks.\n\nYou watch the way the bug carries the crumb like it matters.\n\nI
          am hungry, it says.\nThat\u2019s all."
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 2
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 2
        originDialogueID: 14
        destinationConversationID: 2
        destinationDialogueID: 41
        isConnector: 0
        priority: 2
      - originConversationID: 2
        originDialogueID: 14
        destinationConversationID: 2
        destinationDialogueID: 42
        isConnector: 0
        priority: 2
      - originConversationID: 2
        originDialogueID: 14
        destinationConversationID: 2
        destinationDialogueID: 43
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
      onExecute:
        m_PersistentCalls:
          m_Calls: []
      canvasRect:
        serializedVersion: 2
        x: 2264
        y: 974
        width: 160
        height: 30
    - id: 15
      fields:
      - title: Title
        value: Name it Brutus
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "\u201CBrutus,\u201D you say.\n\nThe bug freezes.\n\nFrom the vent:\n\n\u201CBold
          choice.\u201D\n\nYou look up. \u201CYou heard that?\u201D\n\n\u201CI hear
          everything in here.\u201D\n\nThe bug moves again. Slow. Deliberate.\n\n\u201CEt
          tu?\u201D you whisper when it disappears under the cot."
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 2
      isRoot: 0
      isGroup: 0
      nodeColor: 
