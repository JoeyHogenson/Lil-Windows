      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "You decide not to name it.\n\nNaming makes things permanent.\n\nThe
          bug walks freely now.\n\nYou already named me, you hear it say.\n\nYour
          chest tightens.\n\n\u201CI did not.\u201D\n\nYou called me witness."
        type: 0
        typeString: 
