      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "\u201CSomething Else.\u201D\n\nSilence\n\n\u201CThat\u2019s not a
          helpful,\" says the voice from the vent.\n\n\u201CIt\u2019s accurate,\u201D
          you say.\n\nSilence again.\n\nThe bug climbs the wall.\n\nYou are also
          something else, you hear the bug say."
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
